<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  <div class="w-full h-full bg-zinc-900 p-10 text-white">
    <div class="nav m-3 mb-10">
      <a class="text-blue-500" href="/read">Read Users</a>
    </div>
    <h1 class="m-3 mb-8 text-3xl tracking-tighter">Create User</h1>
    <form action="/create" method="post">
      <input class="px-5 py-2 border-2 border-zinc-800 rounded-lg mx-2 outline-none bg-transparent" name="name" type="text" placeholder="name">
      <input class="px-5 py-2 border-2 border-zinc-800 rounded-lg mx-2 outline-none bg-transparent" name="email" type="text" placeholder="email">
      <input class="px-5 py-2 border-2 border-zinc-800 rounded-lg mx-2 outline-none bg-transparent" name="image" type="text" placeholder="image url">
      <input class="block m-3 text-blue-800 border-2 rounded-lg p-3 border-zinc-800 " type="submit" value="Create User">
    </form>
  </div>
</body>

</html>