<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/style.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  <div class="w-100% h-100% bg-zinc-900 p-10 text-white">
    <a class="text-blue-500 m-3" href="/">Back To Home</a>
    <h1 class="m-3 mb-8 mt-10 text-3xl tracking-tighter">All Users</h1>
    <div class="users flex gap-3 justify-evenly flex-wrap">
      <% if(users.length>0){ %>
        <% users.forEach(function(user){ %>
         <div class="user rounded-lg w-80 p-4 bg-zinc-800">
            <div class="w-full h-72 rounded-lg bg-zinc-700 overflow-hidden">
              <img class="w-full h-full object-cover object-top" src="<%=user.image%>">
            </div>
            <h3 class="text-xl mt-3 tracking-tighter"><%=user.name%></h3>
            <h5 class="text-zinc-500"><%=user.email%></h5>
            <div class="flex gap-3 mt-10">
              <a class="text-zinc-200" href="/edit/<%=user._id%>">Edit User</a>
              <a class="text-purple-200" href="/delete/<%=user._id%>">Delete User</a>
            </div>
         </div>
        <% }) %>
      <%} else { %>
          <h3 class="text-zinc-500"> No user yet</h3>
        <% } %>
       
      
    </div>
  </div>
</body>

</html>